# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already covered by .gitignore.

# --- LLM provider (choose one) ---
GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Which provider to use: "groq" or "gemini"
LLM_PROVIDER=groq

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Lead scoring ---
# Minimum score (0-100) for a lead to be considered "high priority"
LEAD_SCORE_THRESHOLD=70

# --- n8n (only needed if self-hosting via docker-compose) ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
